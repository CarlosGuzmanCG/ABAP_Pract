ZVA_ALFA02-APELLIDO1 =
ZEMPLE_ALFA02-APELLIDO1 .
ZVA_ALFA02-APELLIDO2 =
ZEMPLE_ALFA02-APELLIDO2 .
ZVA_ALFA02-CAT_PROF =
ZEMPLE_ALFA02-CAT_PROF .
ZVA_ALFA02-STATUS =
ZEMPLE_ALFA02-STATUS .
ZVA_ALFA02-PAIS =
ZEMPLE_ALFA02-PAIS .
ENDFORM.
*---------------------------------------------------------------------*
FORM CORR_MAINT_ZVA_ALFA02 USING VALUE(CM_ACTION) RC.
  DATA: RETCODE LIKE SY-SUBRC, COUNT TYPE I, TRSP_KEYLEN TYPE SYFLENG.
  FIELD-SYMBOLS: <TAB_KEY_X> TYPE X.
  CLEAR RC.
MOVE ZVA_ALFA02-NUM_DIR TO
ZEMPLE_ALFA02-NUM_DIR .
MOVE ZVA_ALFA02-MANDT TO
ZEMPLE_ALFA02-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'ZEMPLE_ALFA02'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN ZEMPLE_ALFA02 TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'ZEMPLE_ALFA02'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

ENDFORM.
