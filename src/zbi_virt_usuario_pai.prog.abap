*& Include          ZBI_VIRT_USUARIO_PAI
*&---------------------------------------------------------------------*
*&---------------------------------------------------------------------*
*&      Module  USER_COMMAND_2000  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE user_command_2000 INPUT.

  ok_code = sy-ucomm.

  CASE ok_code.

    when 'BACK'.

      leave to screen 0.

  ENDCASE.

ENDMODULE.
*&---------------------------------------------------------------------*
*&      Module  USER_EXIT_2000  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE user_exit_2000 INPUT.

  ok_code = sy-ucomm.

  IF ok_code EQ 'CANCEL'. " same name of 'gui status' of screen

    LEAVE TO SCREEN 0. " instruction 0

  ENDIF.

ENDMODULE.
